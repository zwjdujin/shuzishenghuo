# 复制为 android/keystore.properties（该文件已 gitignore，绝不入库），按需修改。
# 生成新的签名密钥库（在 android/ 目录执行，口令自设、妥善保存）：
#   keytool -genkeypair -v -keystore app/release.keystore -alias szsh -keyalg RSA -keysize 2048 -validity 10000
#
# 历史说明：v0.5.55 及之前，密钥库与口令曾随仓库公开（审计判定已泄露作废）。
# 换用新密钥后，旧 APK 用户无法覆盖升级，需「卸载重装」——卸载前先在站点「数据安全」导出备份。

# storeFile 相对本文件所在的 android/ 目录
storeFile=app/release.keystore
storePassword=改成你自己的口令
keyAlias=szsh
keyPassword=改成你自己的口令
