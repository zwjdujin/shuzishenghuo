{
  "name": "shuzishenghuo",
  "version": "0.5.31",
  "private": true,
  "description": "数字生活 - 个人数字工作台（Cloudflare Pages + D1 + R2）",
  "scripts": {
    "dev": "wrangler pages dev ./public",
    "deploy": "wrangler pages deploy ./public",
    "release": "node scripts/release.mjs",
    "db:migrate": "wrangler d1 migrations apply shuzishenghuo --local",
    "db:migrate:remote": "wrangler d1 migrations apply shuzishenghuo --remote",
    "db:seed": "wrangler d1 execute shuzishenghuo --local --file=./seed.sql"
  }
}
